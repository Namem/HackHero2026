# Aura backend - variaveis de producao
# Copie para .env.production e preencha valores reais.
# Para gerar SECRET_KEY: openssl rand -hex 32
# IMPORTANTE: POSTGRES_PASSWORD e DB_PASSWORD precisam ter o MESMO valor.

# Django
DJANGO_SECRET_KEY=TROQUE_ESTE_VALOR_openssl_rand_hex_32
DEBUG=False
ALLOWED_HOSTS=numik.com.br,www.numik.com.br
CSRF_TRUSTED_ORIGINS=https://numik.com.br,https://www.numik.com.br

# Postgres - usado pelo container postgres na inicializacao
POSTGRES_USER=aura
POSTGRES_PASSWORD=TROQUE_PARA_SENHA_FORTE
POSTGRES_DB=aura

# Django connecting to postgres - precisa bater com POSTGRES_* acima
DB_NAME=aura
DB_USER=aura
DB_PASSWORD=TROQUE_PARA_SENHA_FORTE
DB_HOST=db
DB_PORT=5432

# Opcional - so se for usar a IA Gemini de verdade.
# Sem chave, /api/analyze/ retorna mock (suficiente para o modo Beta).
GEMINI_API_KEY=
